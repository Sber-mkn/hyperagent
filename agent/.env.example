LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Main ReAct loop — needs reliable structured tool_calls (avoid qwen3-coder-flash)
AGENT_MODEL=qwen/qwen3-coder
# Cheaper model for L2→L3 memory compression (text only, no tools)
SUMMARIZER_MODEL=qwen/qwen3-8b
V3_MAX_OUTPUT_TOKENS=512
V3_MAX_ITERATIONS=20
V3_TEXT_ONLY_STEP_LIMIT=3
