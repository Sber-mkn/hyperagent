# Standalone OpenRouter configuration (`python -m agent.main`).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=qwen/qwen3-coder

# Optional. If omitted, auxiliary nodes use AGENT_MODEL.
# SUMMARIZER_MODEL=qwen/qwen3-8b

# To use Ollama instead, set LLM_PROVIDER=ollama, choose a locally installed
# model in AGENT_MODEL, and uncomment the URL below.
# OLLAMA_URL=http://localhost:11434/api/chat

V3_MAX_OUTPUT_TOKENS=2048
V3_MAX_ITERATIONS=20
V3_L2_TOKEN_BUDGET=15000
