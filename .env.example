# Server-side deployment settings. Copy to .env next to docker-compose.yml.
# docker compose reads this file automatically.

# Where the backend's own ("Hyper") model listens, as seen from the server host.
# The default points at the machine running Docker; use a real host or an
# in-compose service name if the model lives somewhere else.
HYPER_OLLAMA_URL=http://host.docker.internal:11434

# Optional. Clients reach their personal RabbitMQ at the same address they used
# to log in, so this is only needed when that queue lives on a different host
# than the router.
# SERVER_EXTERNAL_IP=
